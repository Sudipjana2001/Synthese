# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API Token (Required for server-side mutations or private datasets)
SANITY_API_TOKEN=your_sanity_api_token

# Revalidation Secret (Required — protects the /api/revalidate endpoint)
REVALIDATION_SECRET=your_random_secret_here

# Site URL (Used for sitemap, RSS feed, and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://synthese.blog
